    BYTES                  = 8
    FORMAT                 = "F8.3"
    NOT_APPLICABLE_CONSTANT = -999.999
    UNKNOWN_CONSTANT       = -998.888
    NULL_CONSTANT          = -997.777
    DESCRIPTION            = "Actual longitude of the surface point at the
                              edge of the FOV on the sunward (left-hand) side
                              of the groundtrack at the observation end."
  END_OBJECT               = COLUMN

END_OBJECT                 = INDEX_TABLE
END
