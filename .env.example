# Local configuration. No credentials are included.
# Keep unauthenticated demo on loopback; production uses identity-bound sessions.
MARSENSE_ENVIRONMENT=demo
MARSENSE_DATABASE_URL=sqlite:///data/runtime/marsense.db
MARSENSE_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
MARSENSE_API_TOKEN=
MARSENSE_AUTH_USERS_FILE=
MARSENSE_AUTH_REQUIRED=false
MARSENSE_READ_ONLY=false
MARSENSE_MODEL_PATH=
MARSENSE_SLOPE_PATH=
MARSENSE_MAX_UPLOAD_BYTES=8388608
# Backend origin is server-side configuration, never a NEXT_PUBLIC secret.
BACKEND_URL=http://127.0.0.1:8000
